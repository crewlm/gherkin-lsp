{
  "name": "@crewlm/gherkin-lsp",
  "version": "0.0.1",
  "description": "Gherkin language server for Python Behave step definitions",
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "main": "dist/cjs/src/index.js",
  "module": "dist/esm/src/index.js",
  "types": "dist/esm/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    },
    "./node": {
      "import": "./dist/esm/src/node/index.js",
      "require": "./dist/cjs/src/node/index.js"
    },
    "./wasm": {
      "import": "./dist/esm/src/wasm/index.js",
      "require": "./dist/cjs/src/wasm/index.js"
    }
  },
  "files": [
    "bin",
    "dist/cjs/src",
    "dist/cjs/package.json",
    "dist/esm/src",
    "node",
    "wasm"
  ],
  "bin": {
    "gherkin-lsp": "bin/gherkin-lsp.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:cjs": "tsc --build tsconfig.build-cjs.json && cp package.cjs.json dist/cjs/package.json",
    "build:esm": "tsc --build tsconfig.build-esm.json",
    "build:version": "node --eval \"console.log('export const version = \\'' + require('./package.json').version + '\\'')\" > src/version.ts",
    "build": "npm run build:version && npm run build:cjs && npm run build:esm",
    "clean": "node --eval \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run test:cjs",
    "test:cjs": "npm run build:cjs && mocha --no-config --recursive dist/cjs/test",
    "pretest": "npm run build:version",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run test && npm run verify:pack",
    "verify:pack": "node scripts/verify-pack.cjs",
    "eslint-fix": "eslint --ext ts --max-warnings 0 --fix src test",
    "eslint": "eslint --ext ts --max-warnings 0 src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crewlm/gherkin-lsp.git"
  },
  "keywords": [
    "cucumber",
    "gherkin",
    "lsp"
  ],
  "author": "CrewLM",
  "contributors": [
    "Viktor Forsman <viktor.forsman@crewlm.ai>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/crewlm/gherkin-lsp/issues"
  },
  "homepage": "https://github.com/crewlm/gherkin-lsp#readme",
  "lint-staged": {
    "{src,test}/**/*.ts": "npm run eslint-fix"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.12.4",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "lint-staged": "^17.0.0",
    "mocha": "11.7.6",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "vscode-jsonrpc": "8.2.1",
    "vscode-languageserver-protocol": "3.17.2"
  },
  "dependencies": {
    "@cucumber/gherkin-utils": "^10.0.0",
    "@cucumber/language-service": "^1.7.0",
    "fast-glob": "3.3.3",
    "source-map-support": "0.5.21",
    "vscode-languageserver": "8.0.2",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-languageserver-types": "3.17.5"
  }
}
